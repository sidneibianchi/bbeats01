{
  "buildCommand": "npm run db:generate && npm run db:migrate && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|samples/|rhythms.json|active_rhythm.json|manifest.json|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/samples/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
